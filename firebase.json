{
  "hosting": {
    "site": "budgeted-studio",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "docs/**",
      "tests/**",
      "firestore.rules",
      "*-debug.log",
      "package*.json",
      "push-client.js",
      "push-config.json"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
